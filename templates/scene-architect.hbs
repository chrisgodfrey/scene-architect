<div class="sa-shell">
  <section class="sa-section sa-hero">
    <h1>Scene Architect</h1>
    <p class="hint">Plan → generate → align → optionally refine → test.</p>
    <ol class="sa-progress" aria-label="Scene creation progress">
      {{#each steps}}
      <li class="sa-progress-item {{className}}" data-step="{{number}}" {{#if current}}aria-current="step"{{/if}}>
        <span class="sa-progress-index" aria-hidden="true">{{#if complete}}✓{{else}}{{number}}{{/if}}</span>
        <span class="sa-progress-label">{{short}}</span>
        <span class="sa-visually-hidden">: {{label}}</span>
      </li>
      {{/each}}
    </ol>
    <p class="sa-status sa-current" role="status">
      <strong>Next:</strong> <span data-next-action-text>
      {{#if next.copyLayoutPrompt}}describe the scene, then copy the layout request.{{/if}}
      {{#if next.copyPlanRepairPrompt}}copy the correction request and send it to ChatGPT.{{/if}}
      {{#if next.pastePlan}}import the corrected full plan JSON.{{/if}}
      {{#if next.buildDraft}}build the validated plan as a Foundry draft.{{/if}}
      {{#if next.exportGuide}}export the reference PNG.{{/if}}
      {{#if next.copyMapPrompt}}copy the complete-map prompt and use it with the reference PNG.{{/if}}
      {{#if next.previewMap}}choose the downloaded map image and preview its alignment.{{/if}}
      {{#if next.copySourceAnalysisPrompt}}copy the same-chat geometry prompt, or choose the fitted-image fallback.{{/if}}
      {{#if next.exportAnalysisImage}}use the fitted-image geometry fallback.{{/if}}
      {{#if next.copyGeometryRepairPrompt}}copy the geometry correction request and send it to ChatGPT.{{/if}}
      {{#if next.importGeometry}}import the corrected complete geometry JSON.{{/if}}
      {{#if next.previewGeometry}}review the proposed geometry overlay before applying it.{{/if}}
      {{#if next.copySourceLightingPrompt}}copy the same-chat lighting prompt, or choose the fitted-image fallback.{{/if}}
      {{#if next.exportLightingImage}}export the fitted-image lighting comparison.{{/if}}
      {{#if next.copyLightRepairPrompt}}copy the lighting correction request and send it to ChatGPT.{{/if}}
      {{#if next.importLighting}}import the complete lighting JSON for review.{{/if}}
      {{#if next.previewLighting}}review the proposed light centres and radii before applying them.{{/if}}
      {{#if next.viewScene}}test the fitted map, geometry and managed lights in Foundry.{{/if}}
      </span>
    </p>
    <div class="sa-actions sa-wrap">
      <select name="projectId" aria-label="Saved Scene Architect scene"><option value="">Choose saved scene…</option>{{#each projects}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
      <button type="button" data-action="reopen">Reopen</button>
      <button type="button" data-action="newProject">New project</button>
      <button type="button" data-action="loadExample">Load laboratory example</button>
    </div>
    {{#if sceneReady}}<p class="sa-status good">Complete: draft scene exists. Working scene: <strong>{{sceneNameLinked}}</strong>.</p>{{/if}}
    {{#if editedGeometry}}<p class="sa-status warning">Native geometry or scene settings differ from the original plan. Manual wall and door edits are supported and preserved. The overlay uses your current walls; reference room labels and feature positions still come from the saved plan.</p>{{/if}}
    {{#if legacyTiles}}<p class="sa-status warning">This scene has {{legacyTiles}} older generated prop Tiles. They stay above any imported map. Build a new scene from the plan for a clean start, or remove unwanted Tiles in Foundry.</p>{{/if}}
  </section>

  <section class="sa-section sa-step {{step1.className}}" data-step="1">
    <details {{#if step1Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">{{#if step1.complete}}✓{{else}}1{{/if}}</span><span>Describe and plan the map</span><span class="sa-step-badge">{{step1.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
      <div class="sa-grid sa-grid-4">
        <label>Scene name<input name="sceneName" value="{{sceneName}}"></label>
        <label>Columns<input type="number" name="columns" min="4" max="200" value="{{columns}}"></label>
        <label>Rows<input type="number" name="rows" min="4" max="200" value="{{rows}}"></label>
        <label>Grid px<input type="number" name="gridSize" min="50" max="400" value="{{gridSize}}"></label>
      </div>
      <label>Describe the map<textarea name="brief" rows="5">{{brief}}</textarea></label>
      <ol class="sa-steps">
        <li>Describe the environment, rooms, important features and desired light sources.</li>
        <li><button class="{{#if next.copyLayoutPrompt}}sa-primary{{/if}}" type="button" data-action="copyLayoutPrompt">Copy layout request</button> and send it to ChatGPT.</li>
        <li><button type="button" data-action="pastePlan">Import / edit plan JSON</button> using the JSON ChatGPT returns. Or load the laboratory example above.</li>
      </ol>
      {{#if planRepair}}
      <div class="sa-status warning" role="status">
        <p><strong>Plan not accepted:</strong> {{planRepair.error}}</p>
        <p>The rejected JSON is retained in this wizard. Your current valid plan, if any, has not changed.</p>
        <div class="sa-actions sa-wrap">
          <button class="{{#if next.copyPlanRepairPrompt}}sa-primary{{/if}}" type="button" data-action="copyPlanRepairPrompt">Copy correction request</button>
          <button class="{{#if next.pastePlan}}sa-primary{{/if}}" type="button" data-action="pastePlan">Import corrected plan JSON</button>
          <button type="button" data-action="copyLayoutPrompt">Copy fresh layout request instead</button>
        </div>
        <p class="hint">Send the correction request in the same ChatGPT conversation. Scene Architect will validate every returned plan again.</p>
      </div>
      {{/if}}
    {{#if hasPlan}}
      <p class="sa-status good">Complete: {{planSummary}}.</p>
      {{#each warnings}}<p class="sa-status warning">{{this}}</p>{{/each}}
      <div class="sa-actions sa-wrap">
        <button class="{{#if next.buildDraft}}sa-primary{{/if}}" type="button" data-action="buildDraft">{{#if sceneReady}}Build a new scene from plan{{else}}Build draft scene{{/if}}</button>
        <button type="button" data-action="downloadPlan">Download original plan JSON</button>
        {{#if sceneReady}}<button type="button" data-action="viewScene">View scene</button>{{/if}}
      </div>
      <details><summary>Inspect original plan</summary><p class="hint">Native edits are saved by Foundry, not written back into this JSON.</p><pre>{{planJson}}</pre></details>
    {{/if}}
      </div>
    </details>
  </section>

  {{#if sceneReady}}
  <section class="sa-section sa-step {{step2.className}}" data-step="2">
    <details {{#if step2Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">{{#if step2.complete}}✓{{else}}2{{/if}}</span><span>Generate one complete map</span><span class="sa-step-badge">{{step2.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
    <ol class="sa-steps">
      <li><button class="{{#if next.exportGuide}}sa-primary{{/if}}" type="button" data-action="exportGuide">Export PNG reference</button>.</li>
      <li><button class="{{#if next.copyMapPrompt}}sa-primary{{/if}}" type="button" data-action="copyMapPrompt">Copy complete-map prompt</button>. Attach the exported reference in the same ChatGPT conversation.</li>
      <li>Generate and download one complete map image. Keep that conversation open if you want to use the no-reattachment geometry and lighting shortcuts in steps 4 and 5.</li>
    </ol>
    <p class="hint">The reference guides architecture, feature placement and visible light sources. Artwork can flow across grid boundaries. Image generation may shift walls or doors, so review the result in Foundry.</p>
      </div>
    </details>
  </section>

  <section class="sa-section sa-step {{step3.className}}" data-step="3">
    <details {{#if step3Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">{{#if step3.complete}}✓{{else}}3{{/if}}</span><span>Import and align the map</span><span class="sa-step-badge">{{step3.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
    <ol class="sa-steps">
      <li><label>Choose the complete map image (PNG, JPEG or WebP, up to 30 MB)<input type="file" name="mapFile" accept="image/png,image/jpeg,image/webp"></label></li>
      <li>Adjust scale or offsets only when needed, then <button class="{{#if next.previewMap}}sa-primary{{/if}}" type="button" data-action="previewMap">preview alignment</button>.</li>
      <li>Inspect the artwork and live-wall overlay, then <button type="button" data-action="applyMap">apply map background</button>.</li>
    </ol>
    {{#if mapSource}}<p class="sa-status good">Complete: a map source is saved. Leave the file empty to reuse {{mapSource}}.</p>{{/if}}
    <p class="hint">The full image initially fits the scene rectangle. A different aspect ratio stretches. Scale is centred; positive offsets move the image right/down. Preview again after every change.</p>
    <div class="sa-grid sa-grid-3">
      <label>Scale (%)<input name="mapScale" type="number" min="10" max="400" step="1" value="{{scale}}"></label>
      <label>Horizontal offset (px)<input name="mapX" type="number" min="-8192" max="8192" value="{{offsetX}}"></label>
      <label>Vertical offset (px)<input name="mapY" type="number" min="-8192" max="8192" value="{{offsetY}}"></label>
    </div>
    <label class="sa-check"><input name="showWalls" type="checkbox" checked> Show live walls and doors in preview</label>
    <p class="hint">Yellow: walls · Blue: doors · Purple: secret doors. The overlay is never baked into your map.</p>
    <p class="sa-map-warning sa-status warning" role="status"></p>
    <div class="sa-map-preview"></div>
      </div>
    </details>
  </section>

  <section class="sa-section sa-step {{step4.className}}" data-step="4">
    <details {{#if step4Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">{{#if step4.complete}}✓{{else}}4{{/if}}</span><span>Fit geometry to the artwork</span><span class="sa-step-badge">{{step4.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
    <p>Scene Architect sends the current vector walls plus room, feature and passage anchors so ChatGPT can compare them with the finished artwork instead of guessing anonymous geometry. This replaces all current walls and doors only after you import, preview and confirm the proposal. Lights, Tiles, tokens and the background stay unchanged. You may skip this optional step and continue to lighting.</p>
    {{#if analysisReady}}
      {{#if sameChatReady}}
      <h3>Recommended: use the original ChatGPT conversation</h3>
      <ol class="sa-steps">
        <li><button class="{{#if next.copySourceAnalysisPrompt}}sa-primary{{/if}}" type="button" data-action="copySourceAnalysisPrompt">Copy same-chat geometry prompt</button>.</li>
        <li>Send it in the conversation that generated the map. The prompt includes the registered vectors; do not attach the image again.</li>
        <li>Paste or upload the returned geometry JSON below.</li>
      </ol>
      {{else}}
      <p class="sa-status warning">The applied map is not linked to a generation request, so the same-chat shortcut is unavailable.</p>
      {{/if}}
      <details {{#unless sameChatReady}}open{{/unless}}>
        <summary>Fallback: attach the exact fitted image</summary>
        <ol class="sa-steps">
          <li><button class="{{#if next.exportAnalysisImage}}sa-primary{{/if}}" type="button" data-action="exportAnalysisImage">Export registered comparison image</button>.</li>
          <li>Attach that exact exported image in ChatGPT. Its labelled cyan vectors and dashed orange passages are translucent priors, not part of the map.</li>
          <li><button type="button" data-action="copyAnalysisPrompt">Copy fitted-image analysis prompt</button> and send it with the attachment.</li>
        </ol>
        <p class="hint">Use this fallback after editing the image, changing conversations, importing an external map, or if ChatGPT cannot inspect the earlier generated image. It includes the applied scale, offsets and current vector correspondence. If you edit Foundry walls after copying either prompt, copy a fresh prompt before import.</p>
      </details>
      {{#if analysisWarning}}<p class="sa-status warning">{{analysisWarning}}</p>{{/if}}
      {{#if geometryRepair}}
      <div class="sa-status warning" role="status">
        <p><strong>Geometry not accepted:</strong> {{geometryRepair.error}}</p>
        <p>The rejected JSON is retained below. No native walls or doors have changed.</p>
        <div class="sa-actions sa-wrap">
          <button class="{{#if next.copyGeometryRepairPrompt}}sa-primary{{/if}}" type="button" data-action="copyGeometryRepairPrompt">Copy geometry correction request</button>
          <button class="{{#if next.importGeometry}}sa-primary{{/if}}" type="button" data-action="importGeometry">Import corrected geometry JSON</button>
          {{#if sameChatReady}}<button type="button" data-action="copySourceAnalysisPrompt">Copy fresh analysis request instead</button>{{else}}<button type="button" data-action="copyAnalysisPrompt">Copy fresh analysis request instead</button>{{/if}}
        </div>
        <p class="hint">Send the correction request in the same ChatGPT conversation. It contains the exact validator error, rejected response and original geometry contract.</p>
      </div>
      {{/if}}
      <label>Geometry JSON<textarea name="geometryJson" rows="6" placeholder="Paste the geometry-analysis JSON here, not the original layout plan">{{geometryJson}}</textarea></label>
      <label>Or choose a JSON file (takes priority over pasted text)<input type="file" name="geometryFile" accept=".json,application/json"></label>
      {{#unless geometryRepair}}<button type="button" data-action="importGeometry">Import geometry for review</button>{{/unless}}
      {{#if hasProposal}}
      <p class="sa-status good">Complete: {{geometrySummary}}.</p>
      {{#if registrationReviewNote}}<p class="sa-status warning">{{registrationReviewNote}}</p>{{/if}}
      {{#each geometryNotes}}<p class="sa-status warning">{{this}}</p>{{/each}}
      {{#each geometryReview}}<p class="sa-status warning">{{this}}</p>{{/each}}
      <label>Geometry overlay<select name="geometryOverlay"><option value="proposed">Proposed geometry</option><option value="current">Current geometry</option><option value="both">Both</option><option value="none">Artwork only</option></select></label>
      <p class="hint">Proposed walls: mint · Doors: pink · Review markers: dashed orange. Current walls: yellow. Open passages are dashed guides only.</p>
      <label class="sa-check"><input type="checkbox" name="geometryReviewed"> I reviewed the marked segments and source-accounting warnings and accept them as a starting point.</label>
      <div class="sa-actions"><button class="{{#if next.previewGeometry}}sa-primary{{/if}}" type="button" data-action="previewGeometry">Preview geometry</button><button type="button" data-action="applyGeometry">Apply proposed geometry</button></div>
      <div class="sa-geometry-preview"></div>
      <p class="hint">Applying saves the previous walls for restoration. Geometry is estimated and may still need correction.</p>
      {{/if}}
    {{else}}<p class="hint">Apply the complete map background in step 3 to enable geometry analysis.</p>{{/if}}
    {{#if hasGeometryBackup}}<button type="button" data-action="restoreGeometry">Restore previous walls</button>{{/if}}
      </div>
    </details>
  </section>

  <section class="sa-section sa-step {{step5.className}}" data-step="5">
    <details {{#if step5Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">{{#if step5.complete}}✓{{else}}5{{/if}}</span><span>Fit lights to visible emitters</span><span class="sa-step-badge">{{step5.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
    <p>Scene Architect compares its managed lights with tangible lamps, flames, portals and machines in the finished artwork. ChatGPT suggests centres, semantic presets and bounded spread classes; Scene Architect supplies complete Foundry settings and validates installed effects. Manual and other-module lights are protected context and are never replaced.</p>
    {{#if analysisReady}}
      {{#if sameChatReady}}
      <h3>Recommended: use the original ChatGPT conversation</h3>
      <ol class="sa-steps">
        <li><button class="{{#if next.copySourceLightingPrompt}}sa-primary{{/if}}" type="button" data-action="copySourceLightingPrompt">Copy same-chat lighting prompt</button>.</li>
        <li>Send it in the conversation that generated the map. The prompt includes managed and protected light context; do not attach the image again.</li>
        <li>Paste or upload the complete lighting JSON below.</li>
      </ol>
      {{else}}
      <p class="sa-status warning">The applied map is not linked to a generation request, so the same-chat lighting shortcut is unavailable.</p>
      {{/if}}
      <details {{#unless sameChatReady}}open{{/unless}}>
        <summary>Fallback: attach the exact fitted lighting comparison</summary>
        <ol class="sa-steps">
          <li><button class="{{#if next.exportLightingImage}}sa-primary{{/if}}" type="button" data-action="exportLightingImage">Export light comparison image</button>.</li>
          <li>Attach that exact image in ChatGPT. Labels beginning M are Scene Architect-managed lights; P labels are protected lights that must remain unchanged.</li>
          <li><button type="button" data-action="copyLightingPrompt">Copy fitted-image lighting prompt</button> and send it with the attachment.</li>
        </ol>
        <p class="hint">Use this fallback after editing the image, changing conversations, importing an external map, or when ChatGPT cannot inspect the earlier image. If any native light changes after the request, copy or export a fresh request before import.</p>
      </details>
      <p class="hint">Ask for tangible emitters only. Bright reflections and baked illumination do not need separate native lights. Current context: {{managedLightCount}} managed and {{protectedLightCount}} protected lights.</p>
      {{#if lightingWarning}}<p class="sa-status warning">{{lightingWarning}}</p>{{/if}}
      {{#if lightRepair}}
      <div class="sa-status warning" role="status">
        <p><strong>Lighting not accepted:</strong> {{lightRepair.error}}</p>
        <p>The rejected JSON is retained below. Native lights and accepted geometry have not changed.</p>
        <div class="sa-actions sa-wrap">
          <button class="{{#if next.copyLightRepairPrompt}}sa-primary{{/if}}" type="button" data-action="copyLightRepairPrompt">Copy lighting correction request</button>
          <button class="{{#if next.importLighting}}sa-primary{{/if}}" type="button" data-action="importLighting">Import corrected lighting JSON</button>
          {{#if sameChatReady}}<button type="button" data-action="copySourceLightingPrompt">Copy fresh lighting request instead</button>{{else}}<button type="button" data-action="copyLightingPrompt">Copy fresh lighting request instead</button>{{/if}}
        </div>
        <p class="hint">Send the correction request in the same ChatGPT conversation. It contains the exact validator error, rejected response and original registered-light contract.</p>
      </div>
      {{/if}}
      <label>Lighting JSON<textarea name="lightingJson" rows="6" placeholder="Paste the finished-map lighting JSON here">{{lightingJson}}</textarea></label>
      <label>Or choose a JSON file (takes priority over pasted text)<input type="file" name="lightingFile" accept=".json,application/json"></label>
      {{#unless lightRepair}}<button type="button" data-action="importLighting">Import lighting for review</button>{{/unless}}
      {{#if hasLightProposal}}
      <p class="sa-status good">Complete: {{lightingSummary}}.</p>
      {{#if lightRegistrationReviewNote}}<p class="sa-status warning">{{lightRegistrationReviewNote}}</p>{{/if}}
      {{#each lightingNotes}}<p class="sa-status warning">{{this}}</p>{{/each}}
      {{#each lightingReview}}<p class="sa-status warning">{{this}}</p>{{/each}}
      <label>Light overlay<select name="lightingOverlay"><option value="proposed">Proposed lights</option><option value="current">Current managed lights</option><option value="both">Current and proposed</option><option value="none">Artwork only</option></select></label>
      <p class="hint">Current: yellow solid bright and dashed dim radii. Proposed: purple solid bright and dotted dim radii. Labels identify every centre; the summary below provides the same information in text.</p>
      <ul class="sa-lighting-details">{{#each lightingDetails}}<li>{{this}}</li>{{/each}}</ul>
      <label class="sa-check"><input type="checkbox" name="lightingReviewed"> I reviewed proposed centres, radii, effects, removals and warnings and accept them as a starting point.</label>
      <div class="sa-actions"><button class="{{#if next.previewLighting}}sa-primary{{/if}}" type="button" data-action="previewLighting">Preview lighting</button><button type="button" data-action="applyLighting">Apply managed lights</button></div>
      <div class="sa-lighting-preview"></div>
      <p class="hint">Applying saves only the previous Scene Architect-managed lights for restoration. Protected lights and all geometry remain unchanged.</p>
      {{/if}}
    {{else}}<p class="hint">Apply the complete map background in step 3 to enable finished-map light fitting.</p>{{/if}}
    {{#if hasLightingBackup}}<button type="button" data-action="restoreLighting">Restore previous managed lights</button>{{/if}}
      </div>
    </details>
  </section>

  <section class="sa-section sa-step {{step6.className}}" data-step="6">
    <details {{#if step6Open}}open{{/if}}>
      <summary class="sa-step-summary">
        <h2><span class="sa-step-number" aria-hidden="true">6</span><span>Test and refine in Foundry</span><span class="sa-step-badge">{{step6.label}}</span></h2>
      </summary>
      <div class="sa-step-body">
    <ol class="sa-steps">
      <li><button class="{{#if next.viewScene}}sa-primary{{/if}}" type="button" data-action="viewScene">View scene</button> and set scene darkness high enough to see lights clearly.</li>
      <li>Check that each lamp, flame or magical source is centred on the feature it represents and has the intended effect.</li>
      <li>Test wall occlusion, doors, movement and token vision with a player-controlled token.</li>
      <li>Use Foundry's native wall and light controls for final artistic adjustments.</li>
    </ol>
    <p class="sa-footer-note">Reapplying a map changes only the background. Applying analysed geometry changes only walls and doors. Applying analysed lighting changes only Scene Architect-managed lights. Geometry and lighting each provide an independent one-level restore.</p>
      </div>
    </details>
  </section>
  {{/if}}
</div>
