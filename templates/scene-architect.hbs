<div class="sa-shell">
  <section class="sa-section">
    <h2><i class="fa-solid fa-wand-magic-sparkles"></i> Scene brief</h2>
    <div class="sa-grid sa-grid-4">
      <label>Scene name
        <input type="text" name="sceneName" value="{{sceneName}}" placeholder="Overton's Laboratory">
      </label>
      <label>Columns
        <input type="number" name="columns" min="4" max="200" step="1" value="{{columns}}">
      </label>
      <label>Rows
        <input type="number" name="rows" min="4" max="200" step="1" value="{{rows}}">
      </label>
      <label>Grid px
        <input type="number" name="gridSize" min="50" max="400" step="1" value="{{gridSize}}">
      </label>
    </div>
    <label>Describe the map
      <textarea name="brief" rows="8" placeholder="Underground steampunk laboratory. Large central experiment chamber...">{{brief}}</textarea>
    </label>
    <div class="sa-actions">
      <button type="button" data-action="copyLayoutPrompt"><i class="fa-regular fa-copy"></i> Copy layout request</button>
      <button type="button" data-action="pastePlan"><i class="fa-solid fa-paste"></i> Paste layout JSON</button>
    </div>
    <p class="hint">Paste the copied request into a frontier web model. It should return a strict grid-layout JSON document. Paste that JSON back here.</p>
  </section>

  <section class="sa-section">
    <h2><i class="fa-solid fa-ruler-combined"></i> Deterministic plan</h2>
    {{#if hasPlan}}
      <div class="sa-status good"><i class="fa-solid fa-circle-check"></i> {{planSummary}}</div>
      <details>
        <summary>Show imported JSON</summary>
        <pre>{{planJson}}</pre>
      </details>
      <div class="sa-actions">
        <button type="button" data-action="buildDraft" class="sa-primary"><i class="fa-solid fa-dungeon"></i> Build draft scene</button>
      </div>
    {{else}}
      <div class="sa-status"><i class="fa-solid fa-circle-info"></i> No layout JSON imported yet.</div>
    {{/if}}
  </section>

  <section class="sa-section">
    <h2><i class="fa-solid fa-flask"></i> Experimental artwork handoff</h2>
    {{#if sceneReady}}
      <div class="sa-status good"><i class="fa-solid fa-link"></i> Working scene: <strong>{{sceneNameLinked}}</strong></div>
      <div class="sa-status warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        General-purpose image generators do not reliably preserve exact wall or grid geometry. This optional workflow may produce an unusable background.
      </div>
      <ol class="sa-steps">
        <li>Review the scene and adjust its native walls or doors. The image guide uses the live geometry.</li>
        <li>
          <button type="button" data-action="downloadImageGuide"><i class="fa-solid fa-image"></i> Download experimental PNG guide + prompt</button>
        </li>
        <li>Upload the PNG directly to ChatGPT or another image model, paste the copied prompt, and ask it to generate the image.</li>
        <li>
          Download the finished PNG, JPEG or WebP, then
          <button type="button" data-action="importArtwork"><i class="fa-solid fa-image"></i> Import as unmanaged background</button>
        </li>
      </ol>
      <details>
        <summary>Advanced: download source files separately</summary>
        <div class="sa-actions sa-wrap">
          <button type="button" data-action="viewScene"><i class="fa-solid fa-eye"></i> View scene</button>
          <button type="button" data-action="exportGuide"><i class="fa-solid fa-file-export"></i> Export SVG guide</button>
          <button type="button" data-action="copyArtPrompt"><i class="fa-regular fa-copy"></i> Copy art prompt</button>
          <button type="button" data-action="downloadPlan"><i class="fa-solid fa-download"></i> Download plan JSON</button>
        </div>
      </details>
    {{else}}
      <div class="sa-status"><i class="fa-solid fa-circle-info"></i> Build a draft scene before exporting optional artwork references.</div>
    {{/if}}
  </section>

  <section class="sa-section sa-footer-note">
    <strong>Deterministic scope:</strong> Scene Architect guarantees the grid, walls, doors, windows and lights it creates. It does not guarantee externally generated artwork.
  </section>
</div>
