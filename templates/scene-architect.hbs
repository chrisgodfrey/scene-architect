<div class="sa-shell">
  <header class="sa-header">
    <ol class="sa-progress" aria-label="Scene creation progress">
      {{#each steps}}
      <li class="sa-progress-item {{#if current}}is-current{{/if}}" {{#if current}}aria-current="step"{{/if}}>
        <span class="sa-progress-index">{{number}}</span><span>{{label}}</span>
      </li>
      {{/each}}
    </ol>
    <p class="sa-status" role="{{#if error}}alert{{else}}status{{/if}}" aria-live="{{#if error}}assertive{{else}}polite{{/if}}" aria-atomic="true" data-status>{{status}}</p>
    <button type="button" data-action="cancelIndex" hidden>Cancel preparation</button>
    {{#if partialScene}}<p role="alert">Partial scene {{partialScene}} remains after cleanup failed. It is NOT complete. Inspect or delete it manually.</p>{{/if}}
  </header>

  <section class="sa-section" data-stage="describe" {{#unless describeStage}}hidden{{/unless}} aria-labelledby="sa-describe-title">
    <h2 id="sa-describe-title" tabindex="-1">What are we building?</h2>
    <p>{{#if assetMode}}Describe the place. Scene Architect will choose assets; your text AI will design the layout.{{else}}Describe the place. Your text AI designs the rooms; an image model supplies the artwork.{{/if}}</p>
    <label>Scene name <input name="sceneName" type="text" value="{{sceneName}}" maxlength="200"></label>
    <label>Scene description <textarea name="brief" rows="5" maxlength="10000" placeholder="An old lighthouse: a keeper's bedroom, a workshop, weathered stone, warm lamps...">{{brief}}</textarea></label>
    <details>
      <summary>Map size: {{columns}} x {{rows}} cells</summary>
      <div class="sa-grid sa-grid-3">
        <label>Columns <input name="columns" type="number" min="4" step="1" value="{{columns}}"></label>
        <label>Rows <input name="rows" type="number" min="4" step="1" value="{{rows}}"></label>
        <label>Grid pixels <input name="gridSize" type="number" min="50" step="1" value="{{gridSize}}"></label>
      </div>
      <p class="hint">Connected rectangular rooms. No circular or curved architecture yet.</p>
    </details>
    {{#if assetMode}}
    {{#if setupOpen}}
    <div class="sa-library-setup">
      <h3>Connect your asset library once</h3>
      <p>Choose a folder on the Foundry server. Subfolders are included. No particular provider or subscription is required.</p>
      <label>Asset folder <input name="assetRoot" value="{{libraryRoot}}" placeholder="assets/map-library"></label>
      <div class="sa-actions sa-wrap">
        <button type="button" data-action="chooseAssetRoot">Browse folders</button>
        <button type="button" data-action="indexLibrary" class="{{#if describeStage}}sa-primary{{/if}}">Connect library</button>
      </div>
      <p class="hint">Large libraries take time to index. Cancelling keeps the previous catalogue available.</p>
    </div>
    {{else}}
    <p class="hint">{{#if automaticAssets}}{{#if libraryConnected}}Assets selected automatically from your connected library.{{else}}Connect a server library once to enable automatic asset selection.{{/if}}{{else}}Manual asset overrides are enabled. <button type="button" data-action="useAutomaticAssets">Use automatic selection</button>{{/if}}</p>
    <div class="sa-actions">
      {{#if libraryConnected}}
      <button type="button" data-action="copyLayoutPrompt" class="{{#if describeStage}}sa-primary{{/if}}">Get AI design request</button>
      {{else}}
      {{#if automaticAssets}}<button type="button" data-action="openSetup" class="{{#if describeStage}}sa-primary{{/if}}">Connect asset library</button>
      {{else}}<button type="button" data-action="copyLayoutPrompt" class="{{#if describeStage}}sa-primary{{/if}}">Get AI design request</button>{{/if}}
      {{/if}}
    </div>
    {{/if}}
    {{else}}
    <button type="button" data-action="copyLayoutPrompt" class="{{#if describeStage}}sa-primary{{/if}}">Get AI design request</button>
    {{/if}}
  </section>

  <section class="sa-section" data-stage="design" {{#unless designStage}}hidden{{/unless}} aria-labelledby="sa-design-title">
    <h2 id="sa-design-title" tabindex="-1">Design with your text AI</h2>
    <p>Give it this request, then paste its complete JSON response below.</p>
    {{#if assetSummary}}<p class="hint">{{#if automaticAssets}}Matched {{palette.length}} candidates automatically. Your AI chooses the final materials and furnishings.{{else}}Using {{palette.length}} manual asset overrides.{{/if}}</p>{{/if}}
    <div data-asset-prompt>
      <label>AI design request <textarea readonly rows="4">{{#if assetMode}}{{assetPrompt}}{{else}}{{intentPrompt}}{{/if}}</textarea></label>
    </div>
    <button type="button" data-action="copyPreparedRequest">{{#if assetRepair}}Copy correction request{{else}}Copy request{{/if}}</button>
    <label>AI response JSON <textarea name="responseText" rows="6" maxlength="1000000" spellcheck="false" aria-invalid="{{#if assetRepair}}true{{else}}false{{/if}}" aria-describedby="sa-response-help" placeholder="Paste the complete JSON response here">{{responseText}}</textarea></label>
    <p class="hint" id="sa-response-help">{{#if assetRepair}}Your response is still editable. Copy the correction request above if needed.{{else}}Paste the JSON only, without code fences or commentary.{{/if}}</p>
    <div class="sa-actions">
      <button type="button" data-action="goDescribe">Edit brief</button>
      <button type="button" data-action="acceptDesign" class="{{#if designStage}}sa-primary{{/if}}">Validate &amp; preview</button>
    </div>
    <p class="hint">Validation and rendering stay local. Nothing is added to your world until you choose Create Scene.</p>
  </section>

  <section class="sa-section" data-stage="preview" {{#unless previewStage}}hidden{{/unless}} aria-labelledby="sa-preview-title">
    <h2 id="sa-preview-title" tabindex="-1">{{#if applied}}Scene saved{{else}}Preview your scene{{/if}}</h2>
    <p>{{planSummary}}</p>
    {{#each warnings}}<p class="sa-status warning">{{this}}</p>{{/each}}
    {{#unless built}}
    <button type="button" data-action="buildPlan" class="{{#if previewStage}}sa-primary{{/if}}" {{#unless hasPlan}}disabled{{/unless}}>Build local preview</button>
    {{/unless}}
    {{#unless assetMode}}
    {{#if built}}
    <p>Download the reference and give it with the prompt to your image model. Then select the completed image.</p>
    <button type="button" data-action="handoff" class="{{#if needsHandoff}}sa-primary{{/if}}">Download reference + copy artwork prompt</button>
    <div data-handoff-text>
      {{#if handoffPrompt}}<details><summary>Artwork prompt</summary><label>Prompt text <textarea readonly rows="5">{{handoffPrompt}}</textarea></label><button type="button" data-action="downloadPrompt">Download artwork prompt</button></details>{{/if}}
    </div>
    <label>Complete artwork image <input name="mapFile" type="file" accept="image/png,image/jpeg,image/webp"></label>
    <p data-selected-file>{{#if selectedName}}Selected: {{selectedName}}{{else}}Choose a local image, or reuse the saved original.{{/if}}</p>
    {{#if mapSource}}<p class="sa-path">Original source: {{mapSource}}</p>{{/if}}
    {{#if legacySource}}<p class="sa-status warning">Legacy source: previous stretch, crop and offset metadata will not be reused.</p>{{/if}}
    <p class="hint">PNG, JPEG or WebP, up to 30 MB and 40 megapixels. The full-frame aspect ratio must match within 0.2%. Small corrections are disclosed; nothing is cropped.</p>
    {{/if}}
    {{/unless}}
    {{#unless hasPreview}}
    {{#if built}}<button type="button" data-action="previewArtwork" class="{{#if assetMode}}{{#unless applied}}{{#if previewStage}}sa-primary{{/if}}{{/unless}}{{/if}}">{{#if assetMode}}Render preview{{else}}Preview artwork composite{{/if}}</button>{{/if}}
    {{/unless}}
    {{#if aspectCorrection}}<p class="sa-status warning" data-artwork-adjustment role="status">Minor aspect correction: {{aspectCorrection}}%. Full image scaled from {{previewMapping.sourceWidth}} x {{previewMapping.sourceHeight}} to {{previewMapping.width}} x {{previewMapping.height}}. Nothing is cropped; native geometry is unchanged.</p>{{/if}}
    <div class="sa-artwork-preview"></div>
    {{#if conflict}}<p class="sa-status warning" role="alert">{{conflict}}</p>{{/if}}
    {{#if hasPreview}}<p class="hint">Check furnishing scale, wall joins and clear entrances. Door artwork is static; native doors control collision and vision.</p>{{/if}}
    {{#if applied}}
    <button type="button" data-action="viewScene" class="{{#if previewStage}}sa-primary{{/if}}">Open Scene for play</button>
    {{else}}
    <label class="sa-check"><input type="checkbox" name="artworkReviewed" {{#unless hasPreview}}disabled{{/unless}}>I inspected this preview; entrances and major features are acceptable.</label>
    <div class="sa-actions sa-wrap">
      {{#if sceneReady}}
      <button type="button" data-action="updateScene" data-commit class="{{#if canUpdate}}{{#if previewStage}}sa-primary{{/if}}{{/if}}" {{#unless canUpdate}}disabled{{/unless}}>Update Scene artwork only</button>
      <button type="button" data-action="createNewScene" data-commit {{#unless hasPreview}}disabled{{/unless}}>Create NEW Scene</button>
      {{else}}
      <button type="button" data-action="createScene" data-commit class="{{#if hasPreview}}{{#if previewStage}}sa-primary{{/if}}{{/if}}" {{#unless hasPreview}}disabled{{/unless}}>Create Scene</button>
      {{/if}}
    </div>
    {{/if}}
    <p class="hint">Saves the exact inspected PNG with native walls, doors and lights. Background updates preserve existing native documents and door states.</p>
    <div class="sa-actions sa-wrap">
      <button type="button" data-action="goDescribe">Edit brief</button>
      {{#if assetRequest}}<button type="button" data-action="goDesign">Edit design JSON</button>{{/if}}
      {{#if hasPreview}}<button type="button" data-action="cancelPreview">Discard preview</button>{{/if}}
    </div>
  </section>

  <details class="sa-section sa-tools">
    <summary>Projects &amp; advanced tools</summary>
    <details>
      <summary>Saved projects</summary>
      <label>Project <select name="projectId"><option value="">Choose a saved scene</option>{{#each projects}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <div class="sa-actions"><button type="button" data-action="reopen">Reopen project</button><button type="button" data-action="newProject">New local project</button></div>
      <p class="hint">Drafts stay on this client. Saved scenes retain their asset palette; unsaved local artwork must be reselected after closing.</p>
    </details>
    {{#if assetMode}}
    <details>
      <summary>Library &amp; manual asset overrides</summary>
      <p class="hint">Automatic selection is the default. Only use manual overrides to correct a specific asset. Inferred scale is an estimate, not a human review.</p>
      {{#if assetSummary}}<p class="hint">{{assetSummary}}</p>{{/if}}
      <div class="sa-actions sa-wrap"><button type="button" data-action="openSetup">Connect or refresh library</button><button type="button" data-action="loadLibrary">Load catalogue for browsing</button><button type="button" data-action="useAutomaticAssets">Use automatic selection</button></div>
      {{#if catalogueCount}}<p>{{catalogueCount}} indexed images loaded.</p>{{/if}}
      <label>Find assets <input name="assetSearch" type="search" value="{{searchQuery}}" placeholder="stone floor, desk, lamp"></label>
      <button type="button" data-action="searchLibrary">Search catalogue</button>
      <div class="sa-asset-results">
        {{#each searchResults}}
        <div class="sa-asset-result"><img src="{{src}}" alt="{{label}}" loading="lazy" decoding="async" width="96" height="96"><p class="sa-path">{{label}}</p><button type="button" data-action="addPaletteAsset" data-id="{{id}}" aria-label="Add {{label}} to palette">Add to palette</button></div>
        {{/each}}
      </div>
      <p class="hint">Materials repeat; walls use horizontal strips. Width includes transparent padding. Editing automatic metadata removes its readiness until you review the override.</p>
      {{#each palette}}
      <fieldset class="sa-palette-entry" data-palette-id="{{id}}">
        <legend>{{label}}</legend>
        <img src="{{src}}" alt="{{label}}" loading="lazy" decoding="async" width="96" height="96">
        <p>{{pixelWidth}} x {{pixelHeight}} pixels; height {{height}} cells. {{#if calibration}}Automatically inferred.{{/if}}</p>
        <div class="sa-grid sa-grid-3">
          <label>Role <select data-field="kind">{{#each roles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
          <label>Full image width (cells) <input data-field="width" type="number" min="0.05" max="100" step="any" value="{{width}}"></label>
          <label>Wall vertical center (0-1) <input data-field="anchorY" type="number" min="0" max="1" step="0.01" value="{{anchorY}}"></label>
        </div>
        <label class="sa-check"><input data-field="confirmed" type="checkbox" {{#if confirmed}}checked{{/if}}>I reviewed this asset's role, scale and wall center.</label>
        <button type="button" data-action="removePaletteAsset" data-id="{{id}}" aria-label="Remove {{label}} from palette">Remove from palette</button>
      </fieldset>
      {{else}}<p>No overrides. Assets will be selected when you prepare a request.</p>{{/each}}
      <button type="button" data-action="applyPalette">Use this manual palette</button>
    </details>
    {{/if}}
    <details>
      <summary>Generated-artwork workflow &amp; low-level plans</summary>
      <label>Workflow <select name="workflowMode"><option value="assets" {{#if assetMode}}selected{{/if}}>Server assets (recommended)</option><option value="artwork" {{#unless assetMode}}selected{{/unless}}>Generated artwork (legacy)</option></select></label>
      <button type="button" data-action="switchWorkflow">Start selected workflow</button>
      {{#unless assetMode}}<button type="button" data-action="loadExample">Load laboratory example</button>{{/unless}}
      <div class="sa-actions sa-wrap"><button type="button" data-action="copyLegacyLayoutPrompt">Copy low-level plan request</button><button type="button" data-action="pastePlan" data-mode="advanced">Import / edit low-level plan</button><button type="button" data-action="downloadPlan" {{#unless hasPlan}}disabled{{/unless}}>Download plan JSON</button></div>
      {{#if planRepair}}<p role="alert">{{planRepair.error}}</p><button type="button" data-action="copyPlanRepairPrompt">Copy plan correction request</button><pre>{{planRepair.json}}</pre>{{/if}}
      {{#if hasPlan}}<pre>{{planJson}}</pre>{{/if}}
    </details>
    {{#if hasPlan}}
    <details>
      <summary>Rendering &amp; diagnostics</summary>
      <div class="sa-grid sa-grid-3">
        <label>Structural material <select name="material" data-rendering><option value="{{settings.material}}" selected>{{settings.material}} (current)</option><option value="stone">Stone</option><option value="wood">Wood</option><option value="metal">Metal</option></select></label>
        <label>Wall width (cells) <input name="wallWidth" data-rendering type="number" min="0.08" max="0.35" step="0.01" value="{{settings.wallWidth}}"></label>
        <label>Protected padding (cells) <input name="bandPadding" data-rendering type="number" min="0.1" max="0.65" step="0.01" value="{{settings.bandPadding}}"></label>
      </div>
      <button type="button" data-action="applyRendering">Apply rendering settings</button>
      <div class="sa-plan-preview"></div>
      <label>Diagnostic view <select name="diagnosticView"><option value="geometry">Geometry only</option><option value="protected">Protected structural mask</option><option value="anchors">Major-anchor mask</option><option value="source">Original source</option><option value="composite">Composite</option></select></label>
      <button type="button" data-action="showDiagnostic">Show diagnostic</button>
      <div class="sa-diagnostic-preview"></div>
    </details>
    {{/if}}
  </details>
</div>
